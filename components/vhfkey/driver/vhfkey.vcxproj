<?xml version="1.0" encoding="utf-8"?>
<!--
  vhfkey.vcxproj - the KMDF build for the virtual HID keyboard driver.

  This exists because hand-assembling cl.exe and link.exe arguments produced a driver that passed every
  structural check and still would not load. The faults found one at a time were:

    1. the image was linked without /DLL, so it was an EXECUTABLE IMAGE rather than a DLL;
    2. the entry point was named DriverEntry instead of FxDriverEntry, so WdfDriverGlobals was never
       initialised and the first framework call dereferenced a null class pointer;
    3. the import descriptor for WDFLDR was discarded by /OPT:REF, because nothing in the driver calls a
       WDFLDR function directly - the KMDF calls are static stubs resolved inside the driver.

  Forcing the descriptor back in with /INCLUDE made the driver import the right five WDFLDR functions
  (WdfLdrQueryInterface, WdfVersionBind, WdfVersionBindClass, WdfVersionUnbind, WdfVersionUnbindClass) and
  it still failed, with WdfVersionBind returning STATUS_INVALID_PARAMETER before DriverEntry ran.

  Every one of those is a piece of what the WDK's KMDF integration already does. Driving the build through
  it removes the whole class of problem instead of guessing at the next missing flag.

  Import order is load-bearing:
    Cpp.Default.props -> WindowsDriver.Default.props -> WDK platform props
    -> Cpp.props -> Cpp.targets -> WindowsDriver.Common.targets
  WindowsDriver.Default.props is what defines TargetPlatformVersion_CO; without it the WDK targets fail with
  MSB4086, comparing an empty string as a number.
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{2A6739B7-EF5F-40E4-B9A9-FECAD822F9B7}</ProjectGuid>
    <RootNamespace>vhfkey</RootNamespace>
    <ProjectName>vhfkey</ProjectName>
    <KmdfVersion>1.31</KmdfVersion>
    <TargetVersion>Windows10</TargetVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WDKContentRoot>C:\Users\Admin\Documents\GitHub\video-factory\vendor\wdk\tools\c\</WDKContentRoot>
    <!-- WindowsDriver.Default.props derives WDKBinRoot from WdkContentRoot, spelled with a lower-case d,
         and falls back to $(WindowsSdkDir)bin when it is unset. That fallback is how the build first failed
         with "could not load ...build\bin\Microsoft.DriverKit.Build.Tasks" - the path was missing the
         10.0.26100.0 segment. Both spellings are set so the value is found either way. -->
    <WdkContentRoot>C:\Users\Admin\Documents\GitHub\video-factory\vendor\wdk\tools\c\</WdkContentRoot>
    <!-- WDKBinRoot is set here rather than left to WindowsDriver.Default.props, whose versioned fallback
         depends on WdkContentRoot already being defined by that point. When it is not, the value collapses
         to $(WindowsSdkDir)bin and the build fails looking for the DriverKit tasks one directory too high.
         Setting it explicitly removes the ordering dependency. -->
    <WDKBinRoot>C:\Users\Admin\Documents\GitHub\video-factory\vendor\wdk\tools\c\build\10.0.26100.0\bin</WDKBinRoot>
    <!-- WDKBuildFolder is the version segment the targets splice into every UsingTask path:
           $(WDKContentRoot)build\$(WDKBuildFolder)\bin\Microsoft.DriverKit.Build.Tasks.$(VisualStudioVersion).dll
         It is normally set by the WDK installer's environment or by the Visual Studio WDK extension. With the
         WDK taken from a NuGet package and no extension, it is empty, so every task path loses its version
         directory and MSBuild reports MSB4062 for a file that exists one level up. -->
    <WDKBuildFolder>10.0.26100.0</WDKBuildFolder>
    <!-- The WDK targets verify the toolchain is installed by testing two paths with Exists():
           MatchingWdkPresent = Exists('$(WDKContentRoot)\Include\$(TargetPlatformVersion)\km\ntddk.h')
           MatchingSdkPresent = Exists('$(WindowsSdkDir)\DesignTime\...\UAP\$(TargetPlatformVersion)\UAP.props')
         Both files are present here, but the properties are evaluated before the paths are made absolute, so
         the tests fail and the build stops with "An SDK corresponding to WDK version was not found". The
         properties are therefore stated directly, which is what the checks are trying to establish. -->
    <MatchingWdkPresent>true</MatchingWdkPresent>
    <MatchingSdkPresent>true</MatchingSdkPresent>
    <!-- WindowsDriver.x64.props appends only the WDK tool directories to ExecutablePath, and because the
         properties that name the VC tool directories are set later, the MSVC bin directory never makes it
         in. The result is TRK0005 "cannot find CL.exe" even though the WDK validation has passed. The
         directory is added here explicitly. -->
    <ExecutablePath>$(ExecutablePath);C:\BuildTools\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64</ExecutablePath>
    <WindowsSdkDir>C:\Program Files (x86)\Windows Kits\10\</WindowsSdkDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <IsKernelModeToolset>true</IsKernelModeToolset>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <SpectreMitigation>false</SpectreMitigation>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(WDKContentRoot)build\10.0.26100.0\WindowsDriver.Default.props" />
  <Import Project="$(WDKContentRoot)build\10.0.26100.0\WindowsDriver.Common.props" />
  <Import Project="$(WDKContentRoot)build\10.0.26100.0\WindowsDriver.x64.props" />
  <Import Project="$(WDKContentRoot)build\10.0.26100.0\WindowsDriver.KernelMode.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- The WDK include and library paths are stated here because the ones the WDK props assemble from
           KM_IncludePath and DDK_LIB_PATH come out empty when the WDK is not laid out under Windows Kits.
           Stating them directly is what makes the kernel headers resolvable. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Include\10.0.26100.0\km;$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Include\10.0.26100.0\shared;$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Include\wdf\kmdf\1.31;$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Include\wdf;C:\Program Files (x86)\Windows Kits\10\Include\10.0.26100.0\shared;C:\Program Files (x86)\Windows Kits\10\Include\10.0.26100.0\um;C:\Program Files (x86)\Windows Kits\10\Include\10.0.26100.0\ucrt;C:\BuildTools\VC\Tools\MSVC\14.44.35207\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <DisableSpecificWarnings>4703;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);vhfkm.lib;ntoskrnl.lib;hal.lib;wmilib.lib;ntstrsafe.lib;BufferOverflowK.lib;wdfldr.lib;wdfdriverentry.lib</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Lib\10.0.26100.0\km\x64;$(MSBuildThisFileDirectory)..\..\..\vendor\wdk\tools\c\Lib\wdf\kmdf\x64\1.31;C:\BuildTools\VC\Tools\MSVC\14.44.35207\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="vhfkey.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="vhfkey.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(WDKContentRoot)build\10.0.26100.0\WindowsDriver.Common.targets" />
</Project>