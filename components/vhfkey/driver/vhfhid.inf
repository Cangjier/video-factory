; vhfhid.inf — installation for the virtual HID keyboard and mouse driver.
;
; Two device nodes, one driver binary and one service. Each node creates exactly one virtual HID device,
; chosen from the hardware ID the node was created with. That is deliberate: an earlier version created
; both virtual devices from a single device object and crashed with an access violation inside the
; framework callback, reading a device pointer that had become invalid between two instructions. Creating
; one virtual device per node removes the shared state that made that possible, and the hardware ID is
; what tells the two nodes apart.
;
; Both are root-enumerated software devices: there is no hardware behind either, so the INF declares a
; root device for each and the driver creates the virtual device when it starts.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = video-factory
CatalogFile = vhfhid.cat
DriverVer   = 10/03/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

; Inf2Cat refuses to build a catalog without this section, reporting that the binary "is missing from
; [SourceDisksFiles]". The section tells the packaging tool which files ship in the package.
[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vhfhid.sys = 1,,

[Manufacturer]
%ProviderName% = VhfHid, NTamd64

[VhfHid.NTamd64]
%KeyboardDeviceName% = VhfHid_Keyboard_Install, root\vhfhidkey
%MouseDeviceName%    = VhfHid_Mouse_Install,    root\vhfhidmouse

; ------------------------------------------------------------------------------------------------
; Keyboard node
; ------------------------------------------------------------------------------------------------

[VhfHid_Keyboard_Install.NT]
CopyFiles = VhfHid_CopyFiles

[VhfHid_Keyboard_Install.NT.HW]
AddReg = VhfHid_Common_AddReg, VhfHid_Keyboard_AddReg

[VhfHid_Keyboard_Install.NT.Services]
AddService = vhfhid, %SPSVCINST_ASSOCSERVICE%, VhfHid_Service

; ------------------------------------------------------------------------------------------------
; Mouse node
; ------------------------------------------------------------------------------------------------

[VhfHid_Mouse_Install.NT]
CopyFiles = VhfHid_CopyFiles

[VhfHid_Mouse_Install.NT.HW]
AddReg = VhfHid_Common_AddReg, VhfHid_Mouse_AddReg

[VhfHid_Mouse_Install.NT.Services]
AddService = vhfhid, %SPSVCINST_ASSOCSERVICE%, VhfHid_Service

; ------------------------------------------------------------------------------------------------
; Shared
; ------------------------------------------------------------------------------------------------

; Registering vhf as a lower filter is what puts the framework beneath this driver in the device stack,
; and it is required: VhfCreate talks to vhf.sys, and without this line the framework is never in the
; stack to answer, so the driver loads and every virtual device it tries to create fails.
[VhfHid_Common_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

; Which virtual device this node creates, written by the installer so the driver does not have to infer it.
; The driver reads this value at device-add time; inferring it from HardwareID does not work, because that
; value is a REG_MULTI_SZ and the framework's string query expects a REG_SZ, so the read fails and both
; nodes fall back to the keyboard.
;
; 0x00010001 is REG_DWORD.
[VhfHid_Keyboard_AddReg]
HKR,,"IsMouse",0x00010001,0

[VhfHid_Mouse_AddReg]
HKR,,"IsMouse",0x00010001,1

[VhfHid_CopyFiles]
vhfhid.sys

[VhfHid_Service]
DisplayName    = %ServiceName%
ServiceType    = 1              ; kernel-mode driver
StartType      = 3              ; demand: the device creates it when the device starts
ErrorControl   = 1              ; normal
ServiceBinary  = %12%\vhfhid.sys

[Strings]
ProviderName       = "video-factory"
KeyboardDeviceName = "Virtual HID Keyboard"
MouseDeviceName    = "Virtual HID Mouse"
ServiceName        = "vhfhid"
DiskName           = "Virtual HID Keyboard and Mouse Installation"
SPSVCINST_ASSOCSERVICE = 0x00000002
