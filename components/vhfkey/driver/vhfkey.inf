; vhfkey.inf — installation for the virtual HID keyboard driver.
;
; The device is a root-enumerated software device: it has no hardware behind it, so the INF declares a
; root device and the driver creates the virtual HID keyboard when it starts. There is no hardware ID
; to match because there is no hardware.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = video-factory
CatalogFile = vhfkey.cat
DriverVer   = 10/03/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

; Inf2Cat refuses to build a catalog without this section, reporting that the binary "is missing from
; [SourceDisksFiles]". The section is what tells the packaging tool which files ship in the package and
; on which media, so its absence is a packaging error rather than a signing detail.
[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vhfkey.sys = 1,,

[Manufacturer]
%ProviderName% = VhfKey, NTamd64

[VhfKey.NTamd64]
; No hardware ID: this is a root-enumerated device created by the installer.
%DeviceName% = VhfKey_Install, root\vhfkey

[VhfKey_Install.NT]
CopyFiles = VhfKey_CopyFiles

; Registering vhf as a lower filter is what puts the framework beneath this driver in the device
; stack, and it is required: VhfCreate talks to vhf.sys, and without this line the framework is never
; in the stack to answer, so the driver loads and every virtual device it tries to create fails.
;
; This section was missing at first, which is the kind of omission that produces a driver that
; installs cleanly and then does nothing.
[VhfKey_Install.NT.HW]
AddReg = VhfKey_Install.NT.AddReg

[VhfKey_Install.NT.AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[VhfKey_Install.NT.Services]
AddService = vhfkey, %SPSVCINST_ASSOCSERVICE%, VhfKey_Service

[VhfKey_CopyFiles]
vhfkey.sys

[VhfKey_Service]
DisplayName    = %ServiceName%
ServiceType    = 1              ; kernel-mode driver
StartType      = 3              ; demand: the device creates it when the device starts
ErrorControl   = 1              ; normal
ServiceBinary  = %12%\vhfkey.sys

[Strings]
ProviderName       = "video-factory"
DeviceName         = "Virtual HID Keyboard"
ServiceName        = "vhfkey"
DiskName           = "Virtual HID Keyboard Installation"
SPSVCINST_ASSOCSERVICE = 0x00000002
