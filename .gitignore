# Node
node_modules/
*.log

# Vendored binaries: fetched by `video_env {action:"install_ffmpeg"}`, and far too large
# to track. SOURCE.json records the url and sha256 of whatever was installed.
#
# The archive is listed separately because the directory rule does not match it: the
# download lands beside the extraction directory, not inside it, and leaving it out
# pulled a ~194 MB zip into the first commit.
vendor/ffmpeg/
vendor/ffmpeg-*.zip
vendor/*.zip
vendor/*.7z

# Vendored OCR engine: fetched by `video_env {action:"install_ocr"}`. 44 MB pruned, 95 MB whole,
# and reproducible from a pinned release URL plus its sha256, so it is not tracked either.
# vendor/ocr/SOURCE.json records what was installed and from where.
vendor/ocr/

# Vendored audio event model and inference runtime: fetched by
# `video_env {action:"install_audio"}`. 28.4 MB, reproducible from pinned URLs — the model by
# file sha256, the runtime by each npm tarball's published sha512 integrity.
#
# The whole directory is ignored, SOURCE.json included, for the same reason as OCR above: the
# manifest describes what a given machine installed, and the pinned URLs plus hashes live in
# src/core/audio-install.mjs, which is tracked. Regenerate with `install-audio`.
vendor/audio/

# Generated stills: reproducible from their prompts, and the point of them is to be
# produced again, not stored.
generated/

# Scratch space: smoke scripts, throwaway renders, generated test material.
tmp/

# Registry-hive transaction logs that sit beside the BCD export. They are transient, and a
# half-written one in the index is worse than none.
*.bcd.LOG1
*.bcd.LOG2

# Local machine state: recorded for the driver work, but it carries this host's address and
# is meaningless anywhere else.
vendor/interception/pre-reboot-state.json

# Driver build toolchain: the WDK and SDK packages are 260 MB of downloads that are
# reproducible from their published URLs, and the extracted trees are several gigabytes of
# Microsoft headers, libraries and tools. None of it belongs in the repository — build.ps1
# fetches and lays it out again. The same applies to the Visual Studio Build Tools
# bootstrapper, whose installer is downloaded on demand.
vendor/wdk/
vendor/vsbt/

# Driver build products. The .sys is reproducible from source, and the intermediates are
# large: the .pdb alone is 600 KB per build and the .ilk as much again.
components/vhfkey/out/
components/vhfkey/build/
# The catalog and the copy of the binary that the INF needs are generated during install, so
# the only tracked driver artifacts are the sources and the INF.
components/vhfkey/driver/*.cat
components/vhfkey/driver/*.sys

# Render output. The demo's out/ is committed on purpose as a working reference, so it
# is re-included below; the intermediate .work/ directory inside it is not.
**/output/
**/.work/

# Generated narration: reproducible from the script text, and a few hundred kilobytes
# of audio each time.
**/narration/voiceover.mp3
**/narration/voiceover.words.json
**/narration/voiceover.cues.json

# Driver install log: records this machine's device state and is regenerated on every run.
components/vhfkey/device-node.log

# Crash analysis transcripts and symbol caches: large, machine-specific, regenerated on demand.
tmp/kd-*.txt


# Windows SDK installer: a 1.3 MB download used once to obtain the debuggers, kept locally.
vendor/dbg/


# MSBuild driver build: object files and the intermediate tree, reproducible from the sources.
components/vhfkey/driver/x64/
components/vhfkey/driver/Release/
*.vcxproj.user


# Driver diagnostic output: the trace file and registry milestones were added while locating the bugs below.
components/vhfkey/device-node.log
components/vhfkey/install-run.log

